    "@upstash/redis": "^1.39.0",
    "drizzle-orm": "^0.44.0",
    "express": "^4.22.3",
    "howler": "^2.2.4",
    "jsonwebtoken": "^9.0.3",
    "resend": "^6.32.1",
    "sigv4-lite": "^1.0.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.0",
    "dotenv": "18.0.8",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^25.0.0",
    "typescript": "^7.0.2",
    "vitest": "^2.1.0"
