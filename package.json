{
  "name": "josephmatthos",
  "version": "1.0.0",
  "description": "Plataforma oficial de Joseph Matthos — site, painel admin, loja de faixas e assinaturas.",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node --env-file=.env.local dev-server.js",
    "dev": "node --env-file=.env.local dev-server.js",
    "hash-admin": "node --env-file=.env.local scripts/hash-admin-password.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@neondatabase/serverless": "^0.10.4",
