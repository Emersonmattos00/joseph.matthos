  color: var(--text-dim);
}
.upload-zone:hover { border-color: var(--accent); color: var(--accent); }

.admin-login-wrap {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 2rem;
