}
.admin-login-card {
  background: var(--bg-elev);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 2.5rem 2rem;
  width: min(400px, 100%);
  box-shadow: 0 30px 60px rgba(0, 0, 0, 0.7);
}
.admin-login-card .brand { text-align: center; margin-bottom: 2rem; }
.admin-login-card .brand h1 { font-size: 1.6rem; font-weight: 700; }
.admin-login-card .brand p {
  color: var(--accent);
  font-size: 0.7rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  margin-top: 0.3rem;
}

.admin-modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.8);
  -webkit-backdrop-filter: blur(6px);
  backdrop-filter: blur(6px);
  z-index: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
  opacity: 0;
  pointer-events: none;
  transition: 0.3s;
}
.admin-modal-overlay.open { opacity: 1; pointer-events: auto; }
.admin-modal {
  background: var(--bg-elev);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 2rem;
  width: min(700px, 100%);
  max-height: 90vh;
  overflow-y: auto;
  position: relative;
}
.admin-modal h3 { font-size: 1.4rem; margin-bottom: 1rem; }

/* ── 20. RESPONSIVO ───────────────────────────────────────────── */
@media (max-width: 1100px) {
  .amz-search-wrap { width: 180px; }
  .amz-nav { gap: 1rem; }
}
@media (max-width: 900px) {
  .amz-nav { display: none; }
  .amz-search-wrap { width: 160px; }
  .artist-spotify { padding-top: 1.75rem; }
  .amz-main { padding: 0 1.25rem 3rem; }
  .amz-grid { grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 1rem; }
  .artist-spotify-name { font-size: 2.25rem; }
  .sobre-grid { grid-template-columns: 1fr; gap: 2rem; }
  .contato-grid { grid-template-columns: 1fr; gap: 3rem; }
  .filter-bar { flex-direction: column; align-items: stretch; }
  .shop-search-wrap { flex: 1 1 auto; max-width: 100%; }

  .player-modal-overlay {
    padding: 0;
    background: linear-gradient(180deg, #2d2420 0%, #1a1a1a 40%, #0b0a0c 100%);
  }
  .music-player {
    max-width: 100%;
    max-height: 100vh;
    height: 100vh;
    border-radius: 0;
    background: linear-gradient(180deg, #2d2420 0%, #1a1a1a 40%, #0b0a0c 100%);
    border: none;
  }
  .player-grid {
    grid-template-columns: 1fr;
    overflow-y: auto;
    padding-top: 16px;
  }
  .player-col { padding: 16px 20px 24px; border-right: none; }
  .music-player .album-cover {
    width: min(70vw, 280px);
    max-width: min(70vw, 280px);
    margin: 0 auto 20px;
  }
  .lyrics-col {
    position: absolute;
    inset: 0;
    padding: 56px 24px 24px;
    background: linear-gradient(180deg, #2d2420 0%, #0b0a0c 60%);
    z-index: 20;
    display: none;
  }
  .music-player.mobile-lyrics .lyrics-col { display: flex; }
  .music-player.mobile-lyrics .player-col { display: none; }
  .mobile-tabs {
    display: flex;
    justify-content: center;
    gap: 8px;
    padding: 12px 20px;
    background: rgba(0, 0, 0, 0.4);
    border-bottom: 1px solid rgba(212, 175, 55, 0.15);
  }
  .mobile-tab {
    flex: 1;
    max-width: 160px;
    padding: 10px 16px;
    background: transparent;
    border: none;
    color: rgba(212, 175, 55, 0.6);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    border-bottom: 2px solid transparent;
  }
  .mobile-tab.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .admin-layout { grid-template-columns: 1fr; }
  .admin-sidebar { position: static; height: auto; }
  .admin-nav { flex-direction: row; overflow-x: auto; padding-bottom: 0.5rem; }
  .admin-nav button {
    white-space: nowrap;
    border-left: none;
    border-bottom: 3px solid transparent;
  }
  .admin-nav button.active { border-left: none; border-bottom-color: var(--accent); }
}
@media (max-width: 600px) {
  .amz-search-wrap { display: none; }
  .amz-upgrade { display: none; }
  .amz-header-inner { padding: 0 1rem; gap: 0.75rem; }
  .amz-logo-text { display: none; }
  .artist-actions { flex-wrap: wrap; }
  .btn-follow { font-size: 0.8rem; padding: 0.65rem 1.2rem; }
  .form-row { grid-template-columns: 1fr; }
  .modal { padding: 1.5rem; }
  .modal h2 { font-size: 1.5rem; }
  .modal.modal-xl { padding: 1.5rem 1rem; }
  .modal.modal-xl .plans-grid { grid-template-columns: 1fr; }
  footer .footer-nav { gap: 0.5rem; font-size: 0.75rem; }
}

